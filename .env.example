# Copy to .env.local, which git ignores. The serve:server task reads it through
# `op run`, so the login can be 1Password references (op://vault/item/field)
# instead of the values themselves. A Raysharp source whose settings in
# sources.json leave its address or login out uses these.
KESTREL_RAYSHARP_HOST=
# The control port, 9000 unless the recorder was changed.
KESTREL_RAYSHARP_PORT=9000
# The RTSP port, from the recorder's network settings.
KESTREL_RAYSHARP_RTSP_PORT=554
KESTREL_RAYSHARP_USERNAME=
KESTREL_RAYSHARP_PASSWORD=
# Only when the recorder has a separate RTSP login
KESTREL_RAYSHARP_RTSP_USERNAME=
KESTREL_RAYSHARP_RTSP_PASSWORD=

{
  "config": {
    "default": true,
    "MD013": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    ".agents/**",
    "packages/desktop/.hutch/**",
    "packages/desktop/build/**",
    // Flathub's shared modules, a submodule
    ".scripts/linux/flatpak/shared-modules/**",
  ],
}

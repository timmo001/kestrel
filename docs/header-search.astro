---
/**
 * docs-kit's header search with the theme picker offering what the app does:
 * Kestrel's own theme first and by default, then the core themes, then the
 * optional ones by family.
 */
import HeaderSearch from "@timmo001/docs-kit/blume/header-search.astro";
import {
  coreThemeChoices,
  optionalThemeChoices,
} from "@timmo001/groundwork-tokens/choices";

const themes = [
  { id: "kestrel", name: "Kestrel" },
  ...coreThemeChoices,
  ...optionalThemeChoices,
];
---

<HeaderSearch {...Astro.props} themes={themes} defaultTheme="kestrel" />

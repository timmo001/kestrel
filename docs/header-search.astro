---
/**
 * docs-kit's header search with the theme picker offering only Base, until
 * the app's own themes are chosen (timmo001/dvr-revival#7).
 */
import HeaderSearch from "@timmo001/docs-kit/blume/header-search.astro";
import { coreThemeChoices } from "@timmo001/groundwork-tokens/choices";

const themes = coreThemeChoices.filter((theme) => theme.id === "base");
---

<HeaderSearch {...Astro.props} themes={themes} defaultTheme="base" />

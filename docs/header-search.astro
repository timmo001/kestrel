---
/**
 * docs-kit's header search with the theme picker offering what the app does:
 * Base first, then the other core themes, then the optional ones by family
 * (timmo001/kestrel#7).
 */
import HeaderSearch from "@timmo001/docs-kit/blume/header-search.astro";
import {
  coreThemeChoices,
  optionalThemeChoices,
} from "@timmo001/groundwork-tokens/choices";

const themes = [
  ...coreThemeChoices.filter((theme) => theme.id === "base"),
  ...coreThemeChoices.filter((theme) => theme.id !== "base"),
  ...optionalThemeChoices,
];
---

<HeaderSearch {...Astro.props} themes={themes} defaultTheme="base" />

{
  "name": "kestrel-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun scripts/theme.ts && blume dev",
    "start": "bun scripts/theme.ts && blume dev",
    "build": "bun scripts/theme.ts && blume build --strict",
    "check": "bun scripts/theme.ts && blume check --strict --isolated",
    "validate": "blume validate --strict",
    "deploy": "alchemy deploy --stage prod --yes",
    "deploy:github": "alchemy deploy --config stacks/github.ts --stage prod --yes",
    "plan": "alchemy plan --stage prod",
    "preview": "blume preview",
    "brand": "bun scripts/brand-images.ts",
    "theme": "bun scripts/theme.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@timmo001/docs-kit": "0.51.0",
    "@timmo001/groundwork-tokens": "0.51.0",
    "blume": "2.2.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/github": "2.0.0-beta.87",
    "@effect/platform-bun": "4.1.4",
    "alchemy": "2.0.0-beta.87",
    "astro": "7.4.12",
    "effect": "4.1.4",
    "prettier": "3.10.1",
    "wrangler": "4.162.0"
  }
}

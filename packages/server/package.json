    "@timmo001/kestrel-nvr": "workspace:*",
    "@timmo001/kestrel-protocol-ftp": "workspace:*",
    "@timmo001/kestrel-source-bambu": "workspace:*",
    "@timmo001/kestrel-source-raysharp": "workspace:*",
    "@timmo001/kestrel-source-reolink": "workspace:*",
    "@timmo001/kestrel-source-stream": "workspace:*",
    "@timmo001/kestrel-source-web": "workspace:*",
    "effect": "4.1.5",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@oxlint/plugins": "1.95.0",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/bun": "1.4.5",
    "@types/web-push": "3.6.4",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"

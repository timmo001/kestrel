{
  "name": "@timmo001/kestrel-server",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/Api.ts",
    "./folders": "./src/Folders.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
